# Safe Phase 0 defaults. This file contains no credentials.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://nyan_local:nyan_local_only@127.0.0.1:5432/nyan_shop_bot
SUPPLIER_MODE=mock
# Local-only credential used when SUPPLIER_MODE=khommo-readonly or multi-readonly.
KHOMMO_API_TOKEN=
# Local-only credentials used when SUPPLIER_MODE=vietshare-readonly or multi-readonly.
VIETSHARE_API_ID=
VIETSHARE_API_SECRET=
PAYMENT_MODE=disabled
ALLOW_REAL_PURCHASES=false
TELEGRAM_BOT_TOKEN=
VITE_API_BASE_URL=/api
