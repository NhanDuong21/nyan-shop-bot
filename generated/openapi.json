{
  "components": {
    "schemas": {
      "AggregateCatalogResponse": {
        "additionalProperties": false,
        "description": "One read-only view over source-qualified products without deduplication.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CatalogProduct"
            },
            "title": "Items",
            "type": "array"
          },
          "mode": {
            "const": "multi-readonly",
            "default": "multi-readonly",
            "title": "Mode",
            "type": "string"
          },
          "omitted_count": {
            "minimum": 0.0,
            "title": "Omitted Count",
            "type": "integer"
          },
          "partial": {
            "title": "Partial",
            "type": "boolean"
          },
          "read_only": {
            "const": true,
            "default": true,
            "title": "Read Only",
            "type": "boolean"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/AggregateSourceReport"
            },
            "minItems": 2,
            "title": "Sources",
            "type": "array"
          },
          "state": {
            "$ref": "#/components/schemas/AggregateCatalogState"
          },
          "supplier": {
            "const": "aggregate",
            "default": "aggregate",
            "title": "Supplier",
            "type": "string"
          }
        },
        "required": [
          "state",
          "items",
          "sources",
          "partial",
          "omitted_count"
        ],
        "title": "AggregateCatalogResponse",
        "type": "object"
      },
      "AggregateCatalogState": {
        "description": "Whether the combined view is complete, degraded, empty, or unavailable.",
        "enum": [
          "complete",
          "partial",
          "empty",
          "error"
        ],
        "title": "AggregateCatalogState",
        "type": "string"
      },
      "AggregateSourceReport": {
        "additionalProperties": false,
        "description": "Sanitized status for one source contributing to the combined view.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CatalogError"
              },
              {
                "type": "null"
              }
            ]
          },
          "freshness": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CatalogFreshness"
              },
              {
                "type": "null"
              }
            ]
          },
          "item_count": {
            "minimum": 0.0,
            "title": "Item Count",
            "type": "integer"
          },
          "mode": {
            "enum": [
              "mock",
              "khommo-readonly",
              "vietshare-readonly"
            ],
            "title": "Mode",
            "type": "string"
          },
          "omitted_count": {
            "default": 0,
            "minimum": 0.0,
            "title": "Omitted Count",
            "type": "integer"
          },
          "partial": {
            "default": false,
            "title": "Partial",
            "type": "boolean"
          },
          "state": {
            "$ref": "#/components/schemas/CatalogState"
          },
          "supplier": {
            "enum": [
              "khommo",
              "vietshare"
            ],
            "title": "Supplier",
            "type": "string"
          }
        },
        "required": [
          "supplier",
          "mode",
          "state",
          "freshness",
          "error",
          "item_count"
        ],
        "title": "AggregateSourceReport",
        "type": "object"
      },
      "ApprovedMappingApproval": {
        "additionalProperties": false,
        "description": "Evidence that an administrator explicitly approved a mapping.",
        "properties": {
          "approved_at": {
            "format": "date-time",
            "title": "Approved At",
            "type": "string"
          },
          "approved_by_admin_id": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "Approved By Admin Id",
            "type": "string"
          },
          "status": {
            "const": "approved",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "approved_by_admin_id",
          "approved_at"
        ],
        "title": "ApprovedMappingApproval",
        "type": "object"
      },
      "Capability": {
        "additionalProperties": false,
        "description": "Capability state plus an explanation whenever it is unavailable.",
        "properties": {
          "reason": {
            "anyOf": [
              {
                "minLength": 1,
                "pattern": ".*\\S.*",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "status": {
            "$ref": "#/components/schemas/CapabilityStatus"
          }
        },
        "required": [
          "status",
          "reason"
        ],
        "title": "Capability",
        "type": "object"
      },
      "CapabilityStatus": {
        "description": "Availability of one narrow supplier-facing operation.",
        "enum": [
          "enabled",
          "disabled",
          "unsupported"
        ],
        "title": "CapabilityStatus",
        "type": "string"
      },
      "CatalogCurationListingInput": {
        "additionalProperties": false,
        "description": "Admin API listing shape using reversible offer keys.",
        "properties": {
          "category": {
            "anyOf": [
              {
                "maxLength": 96,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "description": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "offer_keys": {
            "items": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "title": "Offer Keys",
            "type": "array"
          },
          "retail_price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Money"
              },
              {
                "type": "null"
              }
            ]
          },
          "sort_order": {
            "minimum": 0.0,
            "title": "Sort Order",
            "type": "integer"
          },
          "visible": {
            "title": "Visible",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "category",
          "visible",
          "sort_order",
          "retail_price",
          "offer_keys"
        ],
        "title": "CatalogCurationListingInput",
        "type": "object"
      },
      "CatalogCurationListingView": {
        "additionalProperties": false,
        "description": "Canonical listing projected for the admin UI.",
        "properties": {
          "category": {
            "anyOf": [
              {
                "maxLength": 96,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "description": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "offer_keys": {
            "items": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "title": "Offer Keys",
            "type": "array"
          },
          "retail_price": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Money"
              },
              {
                "type": "null"
              }
            ]
          },
          "sort_order": {
            "minimum": 0.0,
            "title": "Sort Order",
            "type": "integer"
          },
          "visible": {
            "title": "Visible",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "category",
          "visible",
          "sort_order",
          "retail_price",
          "offer_keys"
        ],
        "title": "CatalogCurationListingView",
        "type": "object"
      },
      "CatalogCurationOffer": {
        "additionalProperties": false,
        "description": "Sanitized read-only candidate exposed only to local admin.",
        "properties": {
          "assigned_listing_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9._-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned Listing Id"
          },
          "available_quantity": {
            "minimum": 0.0,
            "title": "Available Quantity",
            "type": "integer"
          },
          "description": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "key": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Key",
            "type": "string"
          },
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "read_only": {
            "const": true,
            "default": true,
            "title": "Read Only",
            "type": "boolean"
          },
          "supplier": {
            "enum": [
              "khommo",
              "vietshare"
            ],
            "title": "Supplier",
            "type": "string"
          },
          "supplier_product_id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Supplier Product Id",
            "type": "string"
          }
        },
        "required": [
          "key",
          "supplier",
          "supplier_product_id",
          "name",
          "description",
          "price",
          "available_quantity",
          "assigned_listing_id"
        ],
        "title": "CatalogCurationOffer",
        "type": "object"
      },
      "CatalogCurationSaveRequest": {
        "additionalProperties": false,
        "description": "Complete optimistic replacement request.",
        "properties": {
          "expected_revision": {
            "minimum": 0.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "listings": {
            "items": {
              "$ref": "#/components/schemas/CatalogCurationListingInput"
            },
            "maxItems": 500,
            "title": "Listings",
            "type": "array"
          }
        },
        "required": [
          "expected_revision",
          "listings"
        ],
        "title": "CatalogCurationSaveRequest",
        "type": "object"
      },
      "CatalogCurationWorkspace": {
        "additionalProperties": false,
        "description": "Complete local admin state without credentials or delivery data.",
        "properties": {
          "listings": {
            "items": {
              "$ref": "#/components/schemas/CatalogCurationListingView"
            },
            "title": "Listings",
            "type": "array"
          },
          "offers": {
            "items": {
              "$ref": "#/components/schemas/CatalogCurationOffer"
            },
            "title": "Offers",
            "type": "array"
          },
          "read_only": {
            "const": true,
            "default": true,
            "title": "Read Only",
            "type": "boolean"
          },
          "revision": {
            "minimum": 0.0,
            "title": "Revision",
            "type": "integer"
          },
          "source_partial": {
            "title": "Source Partial",
            "type": "boolean"
          },
          "supplier_writes_enabled": {
            "const": false,
            "default": false,
            "title": "Supplier Writes Enabled",
            "type": "boolean"
          },
          "unresolved_offer_count": {
            "minimum": 0.0,
            "title": "Unresolved Offer Count",
            "type": "integer"
          }
        },
        "required": [
          "revision",
          "offers",
          "listings",
          "unresolved_offer_count",
          "source_partial"
        ],
        "title": "CatalogCurationWorkspace",
        "type": "object"
      },
      "CatalogDetailFound": {
        "additionalProperties": false,
        "description": "A supported catalog detail read that found a product.",
        "properties": {
          "item": {
            "$ref": "#/components/schemas/CatalogProduct"
          },
          "state": {
            "const": "found",
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "item"
        ],
        "title": "CatalogDetailFound",
        "type": "object"
      },
      "CatalogDetailNotFound": {
        "additionalProperties": false,
        "description": "A supported detail read for an unknown normalized product id.",
        "properties": {
          "product_id": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "Product Id",
            "type": "string"
          },
          "state": {
            "const": "not_found",
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "product_id"
        ],
        "title": "CatalogDetailNotFound",
        "type": "object"
      },
      "CatalogDetailResponse": {
        "discriminator": {
          "mapping": {
            "found": "#/components/schemas/CatalogDetailFound",
            "not_found": "#/components/schemas/CatalogDetailNotFound",
            "unsupported": "#/components/schemas/CatalogDetailUnsupported"
          },
          "propertyName": "state"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/CatalogDetailFound"
          },
          {
            "$ref": "#/components/schemas/CatalogDetailNotFound"
          },
          {
            "$ref": "#/components/schemas/CatalogDetailUnsupported"
          }
        ]
      },
      "CatalogDetailUnsupported": {
        "additionalProperties": false,
        "description": "An honest result for a supplier without a verified detail schema.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/CatalogError"
          },
          "product_id": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "Product Id",
            "type": "string"
          },
          "state": {
            "const": "unsupported",
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state",
          "product_id",
          "error"
        ],
        "title": "CatalogDetailUnsupported",
        "type": "object"
      },
      "CatalogError": {
        "additionalProperties": false,
        "description": "A client-safe error with an explicit retry decision.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/CatalogErrorCode"
          },
          "message": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "CatalogError",
        "type": "object"
      },
      "CatalogErrorCode": {
        "description": "Safe, non-secret catalog failure categories exposed to clients.",
        "enum": [
          "source_unavailable",
          "unsupported"
        ],
        "title": "CatalogErrorCode",
        "type": "string"
      },
      "CatalogFreshness": {
        "additionalProperties": false,
        "description": "Deterministic evidence used to derive fresh versus stale state.",
        "properties": {
          "evaluated_at": {
            "format": "date-time",
            "title": "Evaluated At",
            "type": "string"
          },
          "max_age_seconds": {
            "exclusiveMinimum": 0.0,
            "title": "Max Age Seconds",
            "type": "integer"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/FreshnessStatus"
          }
        },
        "required": [
          "status",
          "observed_at",
          "evaluated_at",
          "max_age_seconds"
        ],
        "title": "CatalogFreshness",
        "type": "object"
      },
      "CatalogListResponse": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/CatalogResponse"
          },
          {
            "$ref": "#/components/schemas/AggregateCatalogResponse"
          }
        ]
      },
      "CatalogProduct": {
        "additionalProperties": false,
        "description": "A normalized product containing one or more distinct variants.",
        "properties": {
          "available_quantity": {
            "minimum": 0.0,
            "title": "Available Quantity",
            "type": "integer"
          },
          "description": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "Description",
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "Id",
            "type": "string"
          },
          "mode": {
            "default": "mock",
            "enum": [
              "mock",
              "khommo-readonly",
              "vietshare-readonly"
            ],
            "title": "Mode",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "Name",
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "read_only": {
            "const": true,
            "default": true,
            "title": "Read Only",
            "type": "boolean"
          },
          "supplier": {
            "default": "mock",
            "enum": [
              "mock",
              "khommo",
              "vietshare"
            ],
            "title": "Supplier",
            "type": "string"
          },
          "variants": {
            "items": {
              "$ref": "#/components/schemas/CatalogVariant"
            },
            "minItems": 1,
            "title": "Variants",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "price",
          "available_quantity",
          "variants"
        ],
        "title": "CatalogProduct",
        "type": "object"
      },
      "CatalogResponse": {
        "additionalProperties": false,
        "description": "Catalog envelope with internally consistent freshness and error state.",
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CatalogError"
              },
              {
                "type": "null"
              }
            ]
          },
          "freshness": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CatalogFreshness"
              },
              {
                "type": "null"
              }
            ]
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CatalogProduct"
            },
            "title": "Items",
            "type": "array"
          },
          "mode": {
            "enum": [
              "mock",
              "khommo-readonly",
              "vietshare-readonly"
            ],
            "title": "Mode",
            "type": "string"
          },
          "omitted_count": {
            "default": 0,
            "minimum": 0.0,
            "title": "Omitted Count",
            "type": "integer"
          },
          "partial": {
            "default": false,
            "title": "Partial",
            "type": "boolean"
          },
          "read_only": {
            "const": true,
            "default": true,
            "title": "Read Only",
            "type": "boolean"
          },
          "state": {
            "$ref": "#/components/schemas/CatalogState"
          },
          "supplier": {
            "default": "mock",
            "enum": [
              "mock",
              "khommo",
              "vietshare"
            ],
            "title": "Supplier",
            "type": "string"
          }
        },
        "required": [
          "mode",
          "state",
          "freshness",
          "items",
          "error"
        ],
        "title": "CatalogResponse",
        "type": "object"
      },
      "CatalogSourceOption": {
        "additionalProperties": false,
        "description": "One explicitly selectable normalized catalog source.",
        "properties": {
          "mode": {
            "enum": [
              "mock",
              "khommo-readonly",
              "vietshare-readonly"
            ],
            "title": "Mode",
            "type": "string"
          },
          "read_only": {
            "const": true,
            "default": true,
            "title": "Read Only",
            "type": "boolean"
          },
          "supplier": {
            "enum": [
              "mock",
              "khommo",
              "vietshare"
            ],
            "title": "Supplier",
            "type": "string"
          }
        },
        "required": [
          "supplier",
          "mode"
        ],
        "title": "CatalogSourceOption",
        "type": "object"
      },
      "CatalogSourcesResponse": {
        "additionalProperties": false,
        "description": "Available sources plus whether clients must choose one explicitly.",
        "properties": {
          "aggregate_available": {
            "default": false,
            "title": "Aggregate Available",
            "type": "boolean"
          },
          "selection_required": {
            "title": "Selection Required",
            "type": "boolean"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/CatalogSourceOption"
            },
            "minItems": 1,
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "sources",
          "selection_required"
        ],
        "title": "CatalogSourcesResponse",
        "type": "object"
      },
      "CatalogState": {
        "description": "Complete UI states represented by the catalog envelope.",
        "enum": [
          "fresh",
          "stale",
          "empty",
          "error"
        ],
        "title": "CatalogState",
        "type": "string"
      },
      "CatalogVariant": {
        "additionalProperties": false,
        "description": "One normalized variant and its exact supplier mapping.",
        "properties": {
          "available_quantity": {
            "minimum": 0.0,
            "title": "Available Quantity",
            "type": "integer"
          },
          "id": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "Id",
            "type": "string"
          },
          "mapping": {
            "$ref": "#/components/schemas/SupplierMapping"
          },
          "name": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "Name",
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "id",
          "name",
          "mapping",
          "price",
          "available_quantity"
        ],
        "title": "CatalogVariant",
        "type": "object"
      },
      "FreshnessStatus": {
        "description": "Whether a snapshot is within its declared maximum age.",
        "enum": [
          "fresh",
          "stale"
        ],
        "title": "FreshnessStatus",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MappingApproval": {
        "discriminator": {
          "mapping": {
            "approved": "#/components/schemas/ApprovedMappingApproval",
            "pending": "#/components/schemas/PendingMappingApproval"
          },
          "propertyName": "status"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/PendingMappingApproval"
          },
          {
            "$ref": "#/components/schemas/ApprovedMappingApproval"
          }
        ]
      },
      "Money": {
        "additionalProperties": false,
        "description": "An integer amount in an explicitly named currency and storage unit.",
        "properties": {
          "amount_minor": {
            "minimum": 0.0,
            "title": "Amount Minor",
            "type": "integer"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          },
          "unit": {
            "const": "minor",
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "amount_minor",
          "currency",
          "unit"
        ],
        "title": "Money",
        "type": "object"
      },
      "PendingMappingApproval": {
        "additionalProperties": false,
        "description": "A proposed supplier mapping that is not active.",
        "properties": {
          "status": {
            "const": "pending",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "PendingMappingApproval",
        "type": "object"
      },
      "SupplierCapabilities": {
        "additionalProperties": false,
        "description": "Read capability truth with all money and delivery operations locked off.",
        "properties": {
          "catalog_detail": {
            "$ref": "#/components/schemas/Capability"
          },
          "catalog_read": {
            "$ref": "#/components/schemas/Capability"
          },
          "delivery": {
            "$ref": "#/components/schemas/Capability"
          },
          "payment": {
            "$ref": "#/components/schemas/Capability"
          },
          "purchase": {
            "$ref": "#/components/schemas/Capability"
          },
          "refund": {
            "$ref": "#/components/schemas/Capability"
          },
          "top_up": {
            "$ref": "#/components/schemas/Capability"
          }
        },
        "required": [
          "catalog_read",
          "catalog_detail",
          "purchase",
          "payment",
          "top_up",
          "refund",
          "delivery"
        ],
        "title": "SupplierCapabilities",
        "type": "object"
      },
      "SupplierMapping": {
        "additionalProperties": false,
        "description": "A reviewed association between one normalized and one supplier variant.",
        "properties": {
          "approval": {
            "$ref": "#/components/schemas/MappingApproval"
          },
          "supplier_product": {
            "$ref": "#/components/schemas/SupplierProductIdentity"
          },
          "supplier_variant": {
            "$ref": "#/components/schemas/SupplierVariantIdentity"
          }
        },
        "required": [
          "supplier_product",
          "supplier_variant",
          "approval"
        ],
        "title": "SupplierMapping",
        "type": "object"
      },
      "SupplierProductIdentity": {
        "additionalProperties": false,
        "description": "The supplier's opaque identity for a product.",
        "properties": {
          "supplier_id": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "Supplier Id",
            "type": "string"
          },
          "supplier_product_id": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "Supplier Product Id",
            "type": "string"
          }
        },
        "required": [
          "supplier_id",
          "supplier_product_id"
        ],
        "title": "SupplierProductIdentity",
        "type": "object"
      },
      "SupplierVariantIdentity": {
        "additionalProperties": false,
        "description": "The supplier's separate opaque identity for a variant.",
        "properties": {
          "supplier_id": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "Supplier Id",
            "type": "string"
          },
          "supplier_variant_id": {
            "minLength": 1,
            "pattern": ".*\\S.*",
            "title": "Supplier Variant Id",
            "type": "string"
          }
        },
        "required": [
          "supplier_id",
          "supplier_variant_id"
        ],
        "title": "SupplierVariantIdentity",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
